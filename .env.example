HOST=0.0.0.0
PORT=3000
BEACON_BASE_URL=https://beacon.example.org
BEACON_TIMEOUT_MS=10000
BEACON_STATS_TIMEOUT_MS=20000
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=10000

# Experimental MCP resource notifications (disabled by default).
BEACON_SUBSCRIPTIONS_ENABLED=false
# Beacon WS is at the server root, NOT /api/v1/ws. Omit to derive from BEACON_BASE_URL.
# BEACON_WS_URL=wss://beacon.example.org/ws
BEACON_SUBSCRIPTIONS_MAX_STREAMS=64
BEACON_SUBSCRIPTIONS_DEBOUNCE_MS=500
