HOST=0.0.0.0
PORT=3000
BEACON_BASE_URL=https://beacon.example.org
BEACON_TIMEOUT_MS=10000
BEACON_STATS_TIMEOUT_MS=20000
BEACON_MAX_RESPONSE_BYTES=5242880
# Generate a strong random bearer token for exposed deployments.
MCP_AUTH_TOKEN=
MCP_LEGACY_MODE=stateless
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp.example.org
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
LOG_LEVEL=info
SHUTDOWN_GRACE_MS=10000
