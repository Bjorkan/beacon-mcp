                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "floodAdvertCount": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "iata": {
                "type": ["string", "null"]
              },
              "lastHeard": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
                    "minimum": -9007199254740991,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Unix epoch milliseconds (UTC)"
