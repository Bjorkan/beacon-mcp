{
  "beacon_compare_observers": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Compare distinct flood packets reported by two observers over the half-open window [since, until). region and regionId are mutually exclusive; observerA and observerB must be different.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "iatas": {
          "description": "IATA identifiers; normalized to uppercase",
          "items": {
            "description": "Three-character IATA identifier; normalized to uppercase",
            "pattern": "^[A-Za-z0-9]{3}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "observerA": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        "observerB": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        "region": {
          "description": "Exact case-sensitive region slug as returned by beacon_list_regions.slug; the display name (e.g. Sverige) will not match",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "regionId": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "type": "integer"
        },
        "since": {
          "description": "RFC3339 UTC timestamp with a valid calendar date, for example 2026-10-04T15:30:00Z",
          "maxLength": 24,
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$",
          "type": "string"
        },
        "until": {
          "description": "RFC3339 UTC timestamp with a valid calendar date, for example 2026-10-04T15:30:00Z",
          "maxLength": 24,
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$",
          "type": "string"
        }
      },
      "required": ["observerA", "observerB", "since", "until"],
      "type": "object"
    },
    "name": "beacon_compare_observers",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "both": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "observerA": {
          "type": ["string", "null"]
        },
        "observerB": {
          "type": ["string", "null"]
        },
        "onlyA": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "onlyB": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "since": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unix epoch milliseconds (UTC)"
        },
        "totalPackets": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "until": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Unix epoch milliseconds (UTC)"
        }
      },
      "type": "object"
    }
  },
