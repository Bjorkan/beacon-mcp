  "beacon_get_top_advertisers": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Get the top advertising nodes ranked by the required sort selection, distinct flood or direct advert packet counts, with ties broken by total adverts and then public key. The default window is the last 24 hours. Flood (route types 0/1) and direct (2/3) counts are included in every result. Each advert counts once per hour, independent of how many selected IATAs heard it. This is a bounded top-N result, not a pageable list. region and regionId are mutually exclusive.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "iatas": {
          "description": "IATA identifiers; normalized to uppercase",
          "items": {
            "description": "Three-character IATA identifier; normalized to uppercase",
            "pattern": "^[A-Za-z0-9]{3}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "limit": {
          "default": 20,
          "description": "Maximum results, from 1 through 50",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "region": {
          "description": "Exact case-sensitive region slug as returned by beacon_list_regions.slug; the display name (e.g. Sverige) will not match",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "regionId": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "type": "integer"
        },
        "since": {
          "description": "RFC3339 UTC timestamp with a valid calendar date, for example 2026-10-04T15:30:00Z",
          "maxLength": 24,
          "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,3})?Z$",
          "type": "string"
        },
        "sort": {
          "enum": ["flood", "direct"],
          "type": "string"
        }
      },
      "required": ["sort"],
      "type": "object"
    },
    "name": "beacon_get_top_advertisers",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "additionalProperties": {},
            "properties": {
              "advertCount": {
                "anyOf": [
                  {
                    "maximum": 9007199254740991,
