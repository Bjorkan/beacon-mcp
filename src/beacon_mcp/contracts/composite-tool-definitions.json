{
  "beacon_diagnose_node": {
    "name": "beacon_diagnose_node",
    "description": "Read-only diagnostic snapshot combining node details, hourly originated activity and up to 20 neighboring nodes; at most three public Beacon GETs, no storage.",
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "range": {
          "type": "string",
          "enum": [
            "24h",
            "48h",
            "168h"
          ],
          "default": "24h"
        },
        "neighborLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 10
        }
      },
      "required": [
        "id"
      ]
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "object",
          "additionalProperties": true
        },
        "activity": {
          "type": "object",
          "additionalProperties": true
        },
        "neighbors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "neighborsTruncated": {
          "type": "boolean"
        },
        "requestedRange": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "node",
        "activity",
        "neighbors",
        "neighborsTruncated",
        "requestedRange",
        "note"
      ]
    }
  },
  "beacon_compare_regions": {
    "name": "beacon_compare_regions",
    "description": "Read-only comparison of independent network overview snapshots for two IATA regions; exactly two public Beacon GETs, no storage.",
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iataA": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{3}$"
        },
        "iataB": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{3}$"
        }
      },
      "required": [
        "iataA",
        "iataB"
      ]
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regionA": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "iata": {
              "type": "string"
            },
            "overview": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "iata",
            "overview"
          ]
        },
        "regionB": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "iata": {
              "type": "string"
            },
            "overview": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "iata",
            "overview"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "regionA",
        "regionB",
        "note"
      ]
    }
  }
}
