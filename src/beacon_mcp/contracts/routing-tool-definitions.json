{
  "beacon_find_cross_iata_routes": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Find routes crossing IATA boundaries by 1-4-byte hop hashes. Supply a directed fromIata/toIata pair, or iatas with at least two distinct codes (not both); omit both to search all IATAs. The upstream computes the full result set before streaming; beacon-mcp stops reading as soon as the requested limit is satisfied, but broad searches can still be slow or time out. This endpoint has no server-side pagination \u2014 if more than 50 results exist, later results are inaccessible; narrow the hashes or IATAs.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "fromHash": {
          "description": "Route hop hash of 1-4 bytes (2, 4, 6, or 8 hexadecimal characters). Matches the specified hash length; shorter hashes are not treated as prefixes of longer ones",
          "pattern": "^(?:[0-9a-fA-F]{2}){1,4}$",
          "type": "string"
        },
        "fromIata": {
          "description": "Three-character IATA identifier; normalized to uppercase",
          "pattern": "^[A-Za-z0-9]{3}$",
          "type": "string"
        },
        "iatas": {
          "description": "Up to 100 IATA codes to search; normalized to uppercase",
          "items": {
            "description": "Three-character IATA identifier; normalized to uppercase",
            "pattern": "^[A-Za-z0-9]{3}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array"
        },
        "limit": {
          "default": 20,
          "description": "Maximum results, from 1 through 50",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "toHash": {
          "description": "Route hop hash of 1-4 bytes (2, 4, 6, or 8 hexadecimal characters). Matches the specified hash length; shorter hashes are not treated as prefixes of longer ones",
          "pattern": "^(?:[0-9a-fA-F]{2}){1,4}$",
          "type": "string"
        },
        "toIata": {
          "description": "Three-character IATA identifier; normalized to uppercase",
          "pattern": "^[A-Za-z0-9]{3}$",
          "type": "string"
        }
      },
      "required": ["fromHash", "toHash"],
      "type": "object"
    },
