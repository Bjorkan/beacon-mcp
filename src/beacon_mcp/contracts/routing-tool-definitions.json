  "beacon_search_traces": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Search trace or ping tags with the timestamp/tag cursor preserved. Both window bounds apply to firstHeardAt and upstream treats until inclusively (since <= firstHeardAt <= until); reported timestamps are truncated to whole milliseconds, so exact-boundary membership can vary. region and regionId are mutually exclusive; cursorTag requires cursor.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "description": "Continuation timestamp returned as pagination.nextCursor.cursor",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "cursorTag": {
          "description": "Continuation trace tag returned as pagination.nextCursor.cursorTag; requires cursor",
          "pattern": "^[0-9a-fA-F]{8}$",
          "type": "string"
        },
        "iatas": {
          "description": "IATA identifiers; normalized to uppercase",
          "items": {
            "description": "Three-character IATA identifier; normalized to uppercase",
            "pattern": "^[A-Za-z0-9]{3}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "limit": {
          "default": 20,
          "description": "Maximum results, from 1 through 50",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "region": {
          "description": "Exact case-sensitive region slug as returned by beacon_list_regions.slug; the display name (e.g. Sverige) will not match",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "regionId": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "type": "integer"
        },
